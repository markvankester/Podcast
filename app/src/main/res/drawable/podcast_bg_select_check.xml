<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/podcast_accent" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/podcast_ic_select_check_mark"
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="?attr/podcast_text_secondary" />
        </shape>
    </item>
</selector>
