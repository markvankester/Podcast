<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/podcast_queue_cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/podcast_player_cover_placeholder"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/podcast_queue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_bold"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:textColor="@color/podcast_white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/podcast_queue_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:textColor="@color/podcast_white_aB8"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/podcast_queue_drag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:alpha="0.8"
        android:contentDescription="@string/podcast_player_reorder"
        android:padding="12dp"
        android:src="@drawable/podcast_player_drag" />
</LinearLayout>
