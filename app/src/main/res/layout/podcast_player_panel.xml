<?xml version="1.0" encoding="utf-8"?>
<de.danoeh.antennapod.ui.podcast.player.PlayerPanelLayer
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/podcast_panel_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/podcast_panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:contentDescription="@string/podcast_player_close_panel" />

    <de.danoeh.antennapod.ui.podcast.player.PlayerGlassLayout
        android:id="@+id/podcast_panel"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="false"
        app:glassBlurDp="40"
        app:glassRadiusDp="34"
        app:glassTintAlpha="0.72">

        <LinearLayout
            android:id="@+id/podcast_panel_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:id="@+id/podcast_panel_handle"
                android:layout_width="88dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/podcast_player_close_panel">

                <View
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/podcast_player_handle" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/podcast_panel_cover"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/podcast_player_cover_placeholder"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/podcast_panel_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope_bold"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/podcast_panel_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope"
                        android:maxLines="1"
                        android:textColor="#BFFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/podcast_panel_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/podcast_player_play_button"
                    android:contentDescription="@string/pause_label"
                    android:padding="15dp"
                    android:src="@drawable/podcast_player_play" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/podcast_player_segmented"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/podcast_panel_tab_queue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="@string/podcast_player_up_next"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/podcast_panel_tab_chapters"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="@string/podcast_player_chapters"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/podcast_panel_tab_notes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:text="@string/podcast_player_notes"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/podcast_panel_queue_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/podcast_panel_chapter_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/podcast_panel_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/manrope_semibold"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="#BFFFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/podcast_panel_notes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="6dp">

                        <TextView
                            android:id="@+id/podcast_panel_chip_date"
                            style="@style/PodcastPlayerChip" />

                        <TextView
                            android:id="@+id/podcast_panel_chip_length"
                            style="@style/PodcastPlayerChip"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <de.danoeh.antennapod.ui.view.ShownotesWebView
                        android:id="@+id/podcast_panel_webview"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/podcast_panel_visit"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center_vertical"
                        android:text="@string/podcast_player_visit_website"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </de.danoeh.antennapod.ui.podcast.player.PlayerGlassLayout>
</de.danoeh.antennapod.ui.podcast.player.PlayerPanelLayer>
