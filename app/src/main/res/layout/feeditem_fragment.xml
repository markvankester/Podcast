<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/podcast_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="top"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="@color/non_square_icon_background"
                app:cardCornerRadius="@dimen/podcast_radius_medium"
                app:cardPreventCornerOverlap="false"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/imgvCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/open_podcast"
                    android:foreground="?attr/selectableItemBackground"
                    tools:src="@tools:sample/avatars" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/txtvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:letterSpacing="-0.02"
                    android:ellipsize="end"
                    android:maxLines="4"
                    style="@style/Podcast.Text"
                    tools:text="@sample/episodes.json/data/title" />

                <TextView
                    android:id="@+id/txtvPodcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:importantForAccessibility="no"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textColor="?attr/podcast_accent"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Podcast title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/txtvPublished"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Podcast.Text.Subtitle"
                        tools:text="Jan 23" />

                    <TextView
                        android:id="@+id/separatorIcons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:importantForAccessibility="no"
                        android:text="·"
                        style="@style/Podcast.Text.Subtitle" />

                    <TextView
                        android:id="@+id/txtvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Podcast.Text.Subtitle"
                        tools:text="@sample/episodes.json/data/duration" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/butAction1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/podcast_bg_pill"
                android:backgroundTint="?attr/podcast_accent"
                android:gravity="center">

                <ImageView
                    android:id="@+id/butAction1Icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    app:tint="?attr/podcast_on_accent"
                    tools:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/butAction1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textColor="?attr/podcast_on_accent"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Button 1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/butAction2"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/podcast_bg_pill"
                android:backgroundTint="?attr/podcast_subtle_fill"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp">

                    <de.danoeh.antennapod.ui.common.CircularProgressBar
                        android:id="@+id/circularProgressBar"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        app:foregroundColor="?attr/podcast_accent" />

                    <ImageView
                        android:id="@+id/butAction2Icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="?attr/podcast_text_primary"
                        tools:src="@drawable/ic_settings" />

                </FrameLayout>

                <TextView
                    android:id="@+id/butAction2Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textColor="?attr/podcast_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Button 2" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/nonSubscribedWarningLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_message_info"
            android:textColor="?attr/podcast_accent"
            android:visibility="gone"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/state_deleted_not_subscribed" />

        <TextView
            android:id="@+id/noMediaLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:textAlignment="center"
            android:text="@string/no_media_label"
            style="@style/Podcast.Text.Subtitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="?attr/podcast_divider" />

    </LinearLayout>

    <de.danoeh.antennapod.ui.common.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        app:preferVertical="3">

        <de.danoeh.antennapod.ui.view.ShownotesWebView
            android:id="@+id/webvDescription"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:windowContentOverlay" />

    </de.danoeh.antennapod.ui.common.NestedScrollableHost>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progbarLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

    </FrameLayout>

</RelativeLayout>
