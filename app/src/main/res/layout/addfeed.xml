<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/podcast_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/podcast_background"
        app:liftOnScroll="false"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:visibility="gone"
            app:navigationContentDescription="@string/toolbar_back_button_content_description"
            app:navigationIcon="?homeAsUpIndicator" />

        <de.danoeh.antennapod.ui.podcast.PodcastHeader
            android:id="@+id/podcast_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/searchbar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/podcast_bg_search_field">

                <ImageView
                    android:id="@+id/searchButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="13dp"
                    android:contentDescription="@string/podcast_search_hint"
                    android:scaleType="fitCenter"
                    app:tint="?attr/podcast_text_secondary"
                    app:srcCompat="@drawable/podcast_ic_search" />

                <EditText
                    android:id="@+id/combinedFeedSearchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:layout_marginEnd="12dp"
                    android:hint="@string/podcast_search_hint"
                    android:textSize="17sp"
                    android:textColorHint="?attr/podcast_text_secondary"
                    android:background="@null"
                    style="@style/Podcast.Text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/searchPodcastsPill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/podcast_search_find_podcasts"
                    android:textSize="15sp"
                    android:textColor="?attr/podcast_on_accent"
                    android:fontFamily="@font/manrope_bold"
                    android:background="@drawable/podcast_bg_pill_accent"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/searchEpisodesPill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/podcast_search_your_episodes"
                    android:textSize="15sp"
                    android:textColor="?attr/podcast_accent"
                    android:fontFamily="@font/manrope_bold"
                    android:background="@drawable/podcast_bg_pill_fill"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingHorizontal="20dp"
                android:text="@string/podcast_discover"
                android:accessibilityHeading="true"
                style="@style/Podcast.Text.Section" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/quickFeedDiscovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:layout_marginHorizontal="16dp"
                android:name="de.danoeh.antennapod.ui.discovery.QuickFeedDiscoveryFragment" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <include
                    android:id="@+id/addViaUrlButton"
                    layout="@layout/podcast_library_row" />

                <include
                    android:id="@+id/opmlImportButton"
                    layout="@layout/podcast_library_row" />

                <include
                    android:id="@+id/searchItunesButton"
                    layout="@layout/podcast_library_row" />

                <include
                    android:id="@+id/searchFyydButton"
                    layout="@layout/podcast_library_row" />

                <include
                    android:id="@+id/searchPodcastIndexButton"
                    layout="@layout/podcast_library_row" />

                <include
                    android:id="@+id/addLocalFolderButton"
                    layout="@layout/podcast_library_row" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
