<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/additional_horizontal_spacing"
    android:layout_marginTop="?attr/actionBarSize"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/podcast_screen_padding"
        android:paddingTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/coverHolder"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/non_square_icon_background"
            app:cardCornerRadius="@dimen/podcast_radius_medium"
            app:cardPreventCornerOverlap="false"
            app:cardElevation="6dp">

            <ImageView
                android:id="@+id/imgvCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                tools:src="@tools:sample/avatars" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textSize="24sp"
                android:fontFamily="@font/manrope_extrabold"
                android:letterSpacing="-0.02"
                style="@style/Podcast.Text"
                tools:text="Podcast title" />

            <TextView
                android:id="@+id/txtvAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                style="@style/Podcast.Text.Subtitle"
                tools:text="Podcast author" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/podcast_screen_padding"
        android:paddingVertical="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/butSubscribe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="@dimen/podcast_screen_padding"
            android:gravity="center"
            android:text="@string/subscribe_label"
            android:textSize="14sp"
            android:textColor="?attr/podcast_on_accent"
            android:fontFamily="@font/manrope_bold"
            android:background="@drawable/podcast_bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/butRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="@dimen/podcast_screen_padding"
            android:gravity="center"
            android:text="@string/restore_archive_label"
            android:textSize="14sp"
            android:textColor="?attr/podcast_accent"
            android:fontFamily="@font/manrope_bold"
            android:background="@drawable/podcast_bg_pill_fill"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/butShowInfo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/podcast_bg_round_fill"
            android:contentDescription="@string/show_info_label"
            android:scaleType="fitCenter"
            android:padding="13dp"
            app:tint="?attr/podcast_text_primary"
            app:srcCompat="@drawable/ic_info_white"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/butFilter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/podcast_bg_round_fill"
            android:contentDescription="@string/filter"
            android:scaleType="fitCenter"
            android:padding="13dp"
            app:tint="?attr/podcast_text_primary"
            app:srcCompat="@drawable/ic_filter_white"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/butShowSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/podcast_bg_round_fill"
            android:contentDescription="@string/show_feed_settings_label"
            android:scaleType="fitCenter"
            android:padding="13dp"
            app:tint="?attr/podcast_text_primary"
            app:srcCompat="@drawable/ic_settings_white"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/podcast_background">

        <TextView
            android:id="@+id/txtvFailure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/icon_red"
            android:visibility="gone"
            android:text="@string/refresh_failed_msg"
            android:layout_marginHorizontal="@dimen/podcast_screen_padding"
            android:layout_marginVertical="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_message_error"
            android:foreground="?android:attr/selectableItemBackground"
            tools:visibility="visible"
            tools:text="(!) Last refresh failed" />

        <TextView
            android:id="@+id/txtvInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:visibility="gone"
            android:gravity="center"
            android:textColor="?attr/podcast_accent"
            tools:visibility="visible"
            tools:text="(i) Information" />

        <TextView
            android:id="@+id/txtvUpdatesDisabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:visibility="gone"
            android:gravity="center"
            android:textColor="?attr/podcast_accent"
            tools:visibility="visible"
            tools:text="Updates disabled" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/descriptionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/podcast_screen_padding"
        android:paddingTop="8dp"
        android:background="?attr/podcast_background"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/subscribeNagLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_message_info"
            android:textColor="?attr/podcast_accent"
            android:text="@string/state_deleted_not_subscribed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/description_label"
            style="@style/Podcast.Text.Section" />

        <TextView
            android:id="@+id/headerDescriptionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="21dp"
            android:maxLines="3"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/selectableItemBackground"
            style="@style/Podcast.Text"
            tools:text="@string/design_time_lorem_ipsum" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_episodes"
            android:layout_marginBottom="4dp"
            style="@style/Podcast.Text.Section" />

    </LinearLayout>

</LinearLayout>
